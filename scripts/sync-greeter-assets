#!/bin/sh
# Copy a user's rx-greeter theme and blurred wallpaper to /var/lib/rx-greeter
# so the greetd user can read them even when the user's home is private.
#
# Run as root after wallpaper/Matugen changes:
#   sudo rx-greeter-sync-assets --user ranxom
#   sudo rx-greeter-sync-assets --user ranxom --theme /path/to/theme.conf
#
# When the user's home is already traversable by greetd (the usual 755/644
# setup), rx-greeter can read the user theme directly; this script is the
# fallback for private homes and a convenient system-wide staging step.

set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "rx-greeter-sync-assets: run as root" >&2
    exit 1
fi

_user="${RX_GREETER_USER:-${SUDO_USER:-}}"
_theme_arg="${RX_GREETER_THEME:-}"
_default_session="${RX_GREETER_DEFAULT_SESSION:-}"
while [ "$#" -gt 0 ]; do
    case "$1" in
        --user)
            [ "$#" -ge 2 ] || { echo "--user requires a name" >&2; exit 2; }
            _user="$2"
            shift 2
            ;;
        --theme)
            [ "$#" -ge 2 ] || { echo "--theme requires a path" >&2; exit 2; }
            _theme_arg="$2"
            shift 2
            ;;
        --default-session)
            [ "$#" -ge 2 ] || { echo "--default-session requires a name" >&2; exit 2; }
            _default_session="$2"
            shift 2
            ;;
        *)
            echo "usage: $0 --user USER [--theme PATH] [--default-session NAME]" >&2
            exit 2
            ;;
    esac
done

if [ -z "${_user}" ]; then
    echo "rx-greeter-sync-assets: --user or RX_GREETER_USER is required" >&2
    exit 2
fi
_home="$(getent passwd "${_user}" | cut -d: -f6)"
if [ -z "${_home}" ] || [ ! -d "${_home}" ]; then
    echo "rx-greeter-sync-assets: no home for user ${_user}" >&2
    exit 1
fi

_dest="/var/lib/rx-greeter"
_theme="${_theme_arg:-${_home}/.config/rx-greeter/theme.conf}"
if [ ! -r "${_theme}" ]; then
    echo "rx-greeter-sync-assets: theme is not readable: ${_theme}" >&2
    exit 1
fi

install -d -m755 "${_dest}"

_bg="$(sed -n 's/^[[:space:]]*background_image[[:space:]]*=[[:space:]]*//p' \
    "${_theme}" | head -n1 | tr -d '"')"
if [ -z "${_bg}" ] || [ ! -r "${_bg}" ]; then
    _bg="${_home}/.cache/swaylock-bg.png"
fi
if [ -r "${_bg}" ]; then
    _theme_bg="${_dest}/background.png"
    if [ "${_bg}" != "${_theme_bg}" ]; then
        install -m644 "${_bg}" "${_theme_bg}"
    fi
else
    _theme_bg=""
fi

_theme_tmp="${_dest}/.theme.conf.$$"
if [ -n "${_theme_bg}" ]; then
    sed "s|^background_image[[:space:]]*=.*|background_image = ${_theme_bg}|" \
        "${_theme}" >"${_theme_tmp}"
else
    grep -v '^[[:space:]]*background_image[[:space:]]*=' "${_theme}" \
        >"${_theme_tmp}" || true
fi
chmod 644 "${_theme_tmp}"
mv -f "${_theme_tmp}" "${_dest}/theme.conf"

# A self-contained fallback config. /etc/rx-greeter/config.conf, if present,
# still takes precedence because /etc is searched first.
_config_tmp="${_dest}/.config.conf.$$"
{
    echo "# Generated by rx-greeter-sync-assets for ${_user}."
    echo "theme_path = ${_dest}/theme.conf"
    if [ -n "${_theme_bg}" ]; then
        echo "background_image = ${_theme_bg}"
    fi
    echo "default_user = ${_user}"
    if [ -n "${_default_session}" ]; then
        echo "default_session = ${_default_session}"
    fi
} >"${_config_tmp}"
chmod 644 "${_config_tmp}"
mv -f "${_config_tmp}" "${_dest}/config.conf"

echo "installed ${_dest}/theme.conf"
echo "installed ${_dest}/config.conf"
if [ -n "${_theme_bg}" ]; then
    echo "wallpaper: ${_theme_bg}"
fi
